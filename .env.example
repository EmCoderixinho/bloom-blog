# Public URL used for canonical links, OG tags and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Admin (service account). Leave empty to run on built-in sample data.
# Firebase console → Project settings → Service accounts → Generate new private key.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the key on one line with literal \n sequences, wrapped in double quotes.
FIREBASE_PRIVATE_KEY=
